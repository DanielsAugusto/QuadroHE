# Copie para .env e ajuste os valores. Nunca commite o .env real.

# Obrigatório. Em produção: aleatório com pelo menos 32 caracteres (não use textos de exemplo).
JWT_SECRET=

PORT=3001

# Primeiro usuário admin — só usado se o banco estiver vazio.
# Em produção ADMIN_PASSWORD é obrigatório (mín. 12 caracteres; não use senhas de exemplo).
ADMIN_EMAIL=admin@secretaria.local
ADMIN_PASSWORD=

# MFA obrigatório para administradores (padrão: ligado em produção).
# QUADROHE_REQUIRE_ADMIN_MFA=1

# Em produção, atrás de proxy reverso (nginx, etc.):
# TRUST_PROXY=1

# URL da API no frontend (dev)
VITE_API_URL=http://localhost:3001

# Opcional (testes): caminho do SQLite. Use :memory: na suíte automatizada.
# QUADROHE_DB_PATH=:memory:
# BCRYPT_ROUNDS=4
